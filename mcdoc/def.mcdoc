
type Gametime = int
type TaskId = int
type Uuid = #[uuid] [int] @ 4
type Command = #[command] string
type PackId = ::slimecore::mcdoc::def::PackId

struct TaskTarget {
    uuid: Uuid,
}
struct Task {
    command: Command,
    targets: [TaskTarget],
    time: Gametime,
    task_id: TaskId,
    data?: any,
    failsafe?: Command,
    attachments: TaskAttachments,
}

struct CommonIn {
    command: Command,
    ticks: int,
    data?: any,
    failsafe?: Command,
    attachments?: TaskAttachments,
}

struct CommonOut {
    task_id: TaskId
}

type TaskAttachments = struct {
	[#[dispatcher_key="delay:task_attachments"] PackId]?: delay:task_attachments[[%key]],
}